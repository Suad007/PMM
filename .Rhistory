#| label: setup
#| message: false
#| warning: false
# install.packages("tidyverse")
# install.packages("palmerpenguins")
# -- Einmal pro Sitzung --
library(tidyverse)
library(palmerpenguins)
#| label: glimpse
glimpse(penguins)
#| label: zielbild
ggplot(penguins,
aes(x = flipper_length_mm, y = body_mass_g, color = species)) +
geom_point() +
labs(x = "Flossengröße (mm)", y = "Körpermasse (g)")
#| label: zielbild
ggplot(penguins,
aes(x = flipper_length_mm, y = body_mass_g, color = species)) +
geom_point() +
labs(x = "Flossengröße (mm)", y = "Körpermasse (g)")
#| label: vorhersage-a
ggplot(penguins, aes(x = species, y = body_mass_g)) + geom_point(color = "red")
ggplot(penguins, aes(x = species, y = body_mass_g, color = species)) + geom_point()
#| label: vorhersage-b
#| error: true
ggplot(penguins, aes(x = body_mass_g))
+ geom_histogram(binwidth = 250)
#| label: eigene-frage
ggplot(penguins,
aes(x = bill_length_mm, y = body_mass_g, color = species)) +
geom_point() +
geom_smooth() +
labs(x = "Schnabellänge (mm)", y = "Körpermasse (g)",
title = "Längere Schnäbel, mehr Gewicht?")
#| label: demo
#| message: false
#| warning: false
library(ggplot2)
library(palmerpenguins)
ggplot(penguins,
aes(x = year, y = body_mass_g)) +
geom_smooth() +
labs(x = "Geburtsjahr (J)", y = "Körpermasse (g)")
#| label: ergaenzung
#| warning: false
ggplot(penguins,
aes(x = year, y = body_mass_g, color = species)) +
geom_point(alpha = 0.6) +
geom_smooth(method = "lm", se = FALSE) +
facet_wrap(~ species) +
labs(x = "Geburtsjahr (J)", y = "Körpermasse (g)",
color = "Art",
title = "Körpermasse der Pinguine nach Art (2007-2009)")
